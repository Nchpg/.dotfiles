
# Profondeur d'imbrication, lue par dotstate. VS Code ouvre son terminal un niveau plus bas.
SHELL_DEPTH=${SHLVL:-1}
if [ "$TERM_PROGRAM" = vscode ]; then
    SHELL_DEPTH=$((SHELL_DEPTH - 1))
fi

if [ "$SHELL_DEPTH" -le 1 ]; then
    FIRST_PROMPT=1
else
    FIRST_PROMPT=0
fi

clear() {
    command clear
    FIRST_PROMPT=1
}

setdev() {
  echo "use flake \"\$MY_FLAKE#$1\"" > .envrc
  direnv allow
}
