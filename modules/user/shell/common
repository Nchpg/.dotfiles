alias ls='eza --icons --sort=name --group-directories-first --color=always'
alias ll='eza -lh --icons --sort=name --group-directories-first --color=always'
alias la='eza -lha --icons --sort=name --group-directories-first --color=always'
alias tree='eza --tree --icons --sort=name --color=always'
alias df='duf'

alias mpv='mpv --keep-open=yes'
alias mpvt='mpv --keep-open=yes --vo=kitty'

alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'

alias cls="clear"
alias su='sudo su -s "$0"'
alias cat="bat --paging=never --style=plain"
alias diff="delta \
          --side-by-side \
          --line-numbers \
          --syntax-theme 'base16-stylix' \
          --hunk-header-style 'bold syntax'"
alias man="batman"

export EDITOR=vim
export VISUAL=vim
export NIX_SHELL_PRESERVE_PROMPT=1

alias fanauto="sudo ec_probe write 0xCF 0x00"
alias fansilent="sudo ec_probe write 0xCF 0x11"
alias fanperf="sudo ec_probe write 0xCF 0x22"

# share the PATH between shells (especially when launching from fish)
alias bash='FROM=$0 PATH_NIX="$PATH" ~/.nix-profile/bin/bash'
alias zsh='FROM=$0 PATH_NIX="$PATH" ~/.nix-profile/bin/zsh'

alias dev-python="VIRTUAL_ENV="" nix develop $MY_FLAKE#python"
alias dev-c="nix develop $MY_FLAKE#c"
alias dev-xpu="nix develop $MY_FLAKE#xpu"

alias gemini="nix run github:nixos/nixpkgs/nixpkgs-unstable#gemini-cli"
alias opencode="nix run github:nixos/nixpkgs/nixpkgs-unstable#opencode"
alias codex="nix run github:nixos/nixpkgs/nixpkgs-unstable#codex"
