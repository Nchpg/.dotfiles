alias ls='eza --icons --sort=name --group-directories-first --color=always'
alias ll='eza -lh --icons --sort=name --group-directories-first --color=always'
alias la='eza -lha --icons --sort=name --group-directories-first --color=always'
alias tree='eza --tree --icons --sort=name --color=always'
alias df='duf'

alias mpv='mpv --keep-open=yes'
alias mpvt='mpv --keep-open=yes --vo=kitty'

alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'

alias cls="clear"
# `$SHELL` et pas `$0` : `su -s` attend un CHEMIN de shell, alors que `$0` vaut
# un simple nom ("fish", "bash" — fish le pose lui-même via `export 0=fish`),
# que su ne sait pas résoudre. $SHELL porte le chemin absolu du shell de login.
alias su='sudo su -s "$SHELL"'
alias cat="bat --paging=never --style=plain"
# 'base16' (thème intégré à bat/delta) : colore avec les 16 couleurs ANSI du
# terminal, donc suit le thème stylix actif, dark comme light. L'ancien
# 'base16-stylix' était le tmTheme généré par le target stylix de bat,
# supprimé depuis que bat gère sa polarité lui-même (cf. modules/user/cli/bat).
alias diff="delta \
          --side-by-side \
          --line-numbers \
          --syntax-theme 'base16' \
          --hunk-header-style 'bold syntax'"
alias man="batman"

# EDITOR/VISUAL : posés une seule fois, via home.sessionVariables
# (modules/user/home-manager), chargés par les trois shells.
export NIX_SHELL_PRESERVE_PROMPT=1

alias fanauto="sudo ec_probe write 0xCF 0x00"
alias fansilent="sudo ec_probe write 0xCF 0x11"
alias fanperf="sudo ec_probe write 0xCF 0x22"


