+    pub(crate) fn tick_startup_workspace(&mut self, outcome: &mut ClientShellInput) {
+        let Some(deadline) = self.startup_workspace_deadline else {
+            return;
+        };
+        if std::time::Instant::now() >= deadline {
+            self.startup_workspace_cwd = None;
+            self.startup_workspace_deadline = None;
+            outcome.repaint = true;
+            return;
+        }
+        if !self.active_endpoint_id.is_local() || self.snapshot.is_none() {
+            return;
+        }
+        let Some(cwd) = self.startup_workspace_cwd.take() else {
+            return;
+        };
+        self.startup_workspace_known = self.snapshot.as_deref().map(|snapshot| {
+            snapshot
+                .workspaces
+                .iter()
+                .map(|workspace| workspace.workspace_id.clone())
+                .collect()
+        });
+        self.push_endpoint_method(
+            crate::api::schema::Method::WorkspaceCreate(crate::api::schema::WorkspaceCreateParams {
+                source_workspace_id: None,
+                cwd: Some(cwd),
+                focus: true,
+                label: None,
+                env: Default::default(),
+            }),
+            outcome,
+        );
+        outcome.repaint = true;
+    }
+
+    /// The startup workspace is focused and its panes are in the surface: safe to draw.
+    pub(super) fn startup_workspace_ready(&self) -> bool {
+        let Some(known) = self.startup_workspace_known.as_ref() else {
+            return false;
+        };
+        let Some(focused) = self
+            .snapshot
+            .as_deref()
+            .and_then(|snapshot| snapshot.focused_workspace_id.as_deref())
+        else {
+            return false;
+        };
+        if known.iter().any(|id| id == focused) {
+            return false;
+        }
+        let prefix = format!("{focused}:");
+        self.pane_surface.as_ref().is_some_and(|surface| {
+            surface
+                .panes
+                .iter()
+                .any(|pane| pane.pane_id.starts_with(&prefix))
+        })
+    }
+
