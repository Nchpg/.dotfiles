+    /// Show a collapsed sidebar while switching workspaces, so the new position is visible.
+    /// Each switch pushes the deadline back. Returns true when the layout changed.
+    pub(super) fn peek_sidebar(&mut self) -> bool {
+        let deadline = std::time::Instant::now() + std::time::Duration::from_millis(500);
+        if self.sidebar_peek_deadline.is_some() {
+            self.sidebar_peek_deadline = Some(deadline);
+            return false;
+        }
+        if !self.sidebar_collapsed {
+            return false;
+        }
+        self.sidebar_collapsed = false;
+        self.sidebar_peek_deadline = Some(deadline);
+        self.reveal_navigation_workspace = true;
+        true
+    }
+
+    pub(crate) fn tick_sidebar_peek(&mut self, now: std::time::Instant) -> bool {
+        if self
+            .sidebar_peek_deadline
+            .is_some_and(|deadline| now >= deadline)
+        {
+            self.sidebar_peek_deadline = None;
+            self.sidebar_collapsed = true;
+            return true;
+        }
+        false
+    }
+
