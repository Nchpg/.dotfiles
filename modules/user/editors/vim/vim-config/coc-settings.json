{
    "suggest.noselect": false,
    "languageserver": {
        "c": {
            "command": "clangd",
            "args": [
                "--enable-config"
            ],
            "rootPatterns": [
                "compile_flags.txt",
                "compile_commands.json"
            ],
            "filetypes": [
                "c",
                "cc",
                "cpp",
                "c++",
                "objc",
                "objcpp"
            ]
        },
        "python": {
            "command": "pyright-langserver",
            "args": ["--stdio"],
            "filetypes": ["python"],
            "settings": {
                "python": {
                    "linting": {
                        "enabled": true,
                        "pylintEnabled": true,
                        "flake8Enabled": true
                    },
                    "formatting": {
                        "provider": "black",
                        "blackArgs": ["--line-length", "88"]
                    },
                    "analysis": {
                        "typeCheckingMode": "basic"
                    }
                }
            }
        }
    },
    "coc.preferences.formatOnSave": true,
    "inlayHint.enableParameterNames": false, 
    "inlayHint.enable": false
}