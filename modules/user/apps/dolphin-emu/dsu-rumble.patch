+// Sends the rumble intensity when it changes, and again every RUMBLE_RESEND_INTERVAL: a lost packet
+// must not leave the controller rumbling, or still.
+void Device::SendRumble(SteadyClock::time_point now)
+{
+  const u8 intensity = m_rumble.load(std::memory_order_relaxed);
+  if (intensity == m_rumble_sent && now < m_next_rumble)
+    return;
+  m_rumble_sent = intensity;
+  m_next_rumble = now + RUMBLE_RESEND_INTERVAL;
+
+  Proto::Message<Proto::MessageType::RumbleRequest> msg(m_client_uid);
+  auto& rumble = msg.m_message;
+  rumble.register_flags = Proto::RegisterFlags::PadID;
+  rumble.pad_id_to_register = m_index;
+  rumble.motor_id = 0;
+  rumble.intensity = intensity;
+  msg.Finish();
+  const std::optional<sf::IpAddress> server_ip = sf::IpAddress::resolve(m_server_address);
+  if (!server_ip ||
+      m_socket.send(&rumble, sizeof(rumble), *server_ip, m_server_port) != sf::Socket::Status::Done)
+  {
+    ERROR_LOG_FMT(CONTROLLERINTERFACE, "DualShockUDPClient SendRumble send failed");
+  }
+}
