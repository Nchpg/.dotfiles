+// Mario Kart Wii's race stage plus one, 0 outside a race: Raceinfo::sInstance only exists during a race, and its
+// stage (offset 0x28) goes intro, countdown, race, finishing, finished. Addresses from SeekyCt/mkw-structures and
+// the region offsets of MKW-SP/Pulsar mods.
+u8 Device::ReadRaceStage() const
+{
+  if (m_race_info == 0)
+    return 0;
+  auto& memory = ::Core::System::GetInstance().GetMemory();
+  if (!memory.IsInitialized())
+    return 0;
+  // A pointer to MEM1 or MEM2, checked first: reading elsewhere would raise a panic alert.
+  const auto readable = [&memory](u32 address) {
+    const u32 offset = address & 0x0FFFFFFF;
+    return address % 4 == 0 &&
+           (((address >> 28) == 0x8 && offset + 4 <= memory.GetRamSizeReal()) ||
+            ((address >> 28) == 0x9 && offset + 4 <= memory.GetExRamSizeReal()));
+  };
+  if (!readable(m_race_info))
+    return 0;
+  const u32 race_info = memory.Read_U32(m_race_info);
+  if (race_info == 0 || !readable(race_info + 0x28))
+    return 0;
+  return static_cast<u8>(std::min<u32>(memory.Read_U32(race_info + 0x28), 0xFE) + 1);
+}
+
+// Tells the server which game runs and, for Mario Kart Wii, the race stage, so the phone shows the controls
+// that fit: on a stage change, and every GAME_INFO_INTERVAL (lost packet, server restarted).
+void Device::SendGameInfo(SteadyClock::time_point now)
+{
+  // Emulated memory is only read from the emulation thread, which polls the Wii Remotes and GameCube
+  // controllers; the host thread polls hotkeys.
+  const InputChannel channel = ControllerInterface::GetCurrentInputChannel();
+  if (channel == InputChannel::Bluetooth || channel == InputChannel::SerialInterface)
+    m_race_stage = ReadRaceStage();
+  if (m_race_stage == m_race_stage_sent && now < m_next_game_info)
+    return;
+  m_race_stage_sent = m_race_stage;
+  m_next_game_info = now + GAME_INFO_INTERVAL;
+
+  // "00000000" when no game runs.
+  const std::string game_id = SConfig::GetInstance().GetGameID();
+  const bool running = game_id.size() == 6;
+  m_race_info = 0;
+  if (running && game_id.starts_with("RMC"))
+  {
+    switch (game_id[3])
+    {
+    case 'P':
+      m_race_info = 0x809BD730;
+      break;
+    case 'E':
+      m_race_info = 0x809B8F70;
+      break;
+    case 'J':
+      m_race_info = 0x809BC790;
+      break;
+    case 'K':
+      m_race_info = 0x809ABD70;
+      break;
+    }
+  }
+
+  Proto::Message<Proto::MessageType::GameInfo> msg(m_client_uid);
+  auto& info = msg.m_message;
+  if (running)
+    std::copy(game_id.begin(), game_id.end(), info.game_id.begin());
+  info.race_stage = m_race_info != 0 ? m_race_stage : 0;
+  msg.Finish();
+  const std::optional<sf::IpAddress> server_ip = sf::IpAddress::resolve(m_server_address);
+  if (!server_ip ||
+      m_socket.send(&info, sizeof(info), *server_ip, m_server_port) != sf::Socket::Status::Done)
+  {
+    ERROR_LOG_FMT(CONTROLLERINTERFACE, "DualShockUDPClient SendGameInfo send failed");
+  }
+}
