+// (Unofficial) Rumble controller motor: intensity 0-255 of one motor of the controller identified as in
+// PadDataRequest. Clients re-send it regularly, servers stop the motor when it stops coming.
+struct RumbleRequest
+{
+  static constexpr auto FROM = CLIENT;
+  static constexpr auto TYPE = 0x110002U;
+  MessageHeader header;
+  u32 message_type;
+  RegisterFlags register_flags;
+  u8 pad_id_to_register;
+  std::array<u8, 6> mac_address_to_register;
+  u8 motor_id;
+  u8 intensity;
+};
+
+// (Unofficial) Game running in the client: its six-character ID (zeros when none) and, for Mario Kart Wii, the
+// race stage plus one (0 outside a race). Clients re-send it every second.
+struct GameInfo
+{
+  static constexpr auto FROM = CLIENT;
+  static constexpr auto TYPE = 0x110003U;
+  MessageHeader header;
+  u32 message_type;
+  std::array<char, 6> game_id;
+  u8 race_stage;
+};
