-static void ext_session_lock_surface_v1_handle_configure(void *data,
-		struct ext_session_lock_surface_v1 *lock_surface, uint32_t serial,
-		uint32_t width, uint32_t height) {
-	struct swaylock_surface *surface = data;
-	surface->width = width;
-	surface->height = height;
+// Applique le dernier configure reçu SI un tampon à sa taille peut être
+// attaché ; sinon (les deux tampons encore tenus par le compositeur, cas de
+// configures rapprochés au branchement/débranchement d'écran) on garde
+// l'ancienne taille, toujours valide puisque rien n'est acquitté, et on
+// réessaie à la prochaine frame. Avant : ack + commit sans tampon à la
+// nouvelle taille -> « committed surface dimensions do not match last
+// acked configure », sway tue le locker, écran rouge sans issue.
+static void apply_pending_configure(struct swaylock_surface *surface) {
+	if (!surface->configure_pending) {
+		return;
+	}
+	uint32_t old_width = surface->width, old_height = surface->height;
+	surface->width = surface->pending_width;
+	surface->height = surface->pending_height;
 	surface->indicator_width = 0;
 	surface->indicator_height = 0;
 	// Render before we send the ACK event, so that we minimize flickering
 	// This means we cannot commit immediately after rendering -- we will have
 	// to send the ACK first and then commit.
-	render_frame_background(surface, false);
-	ext_session_lock_surface_v1_ack_configure(lock_surface, serial);
+	if (!render_frame_background(surface, false)) {
+		surface->width = old_width;
+		surface->height = old_height;
+		damage_surface(surface);
+		return;
+	}
+	surface->configure_pending = false;
+	ext_session_lock_surface_v1_ack_configure(
+		surface->ext_session_lock_surface_v1, surface->pending_serial);
 	wl_surface_commit(surface->surface);
 	render_frame(surface);
 }
 
+static void ext_session_lock_surface_v1_handle_configure(void *data,
+		struct ext_session_lock_surface_v1 *lock_surface, uint32_t serial,
+		uint32_t width, uint32_t height) {
+	struct swaylock_surface *surface = data;
+	surface->configure_pending = true;
+	surface->pending_serial = serial;
+	surface->pending_width = width;
+	surface->pending_height = height;
+	apply_pending_configure(surface);
+}
+
 static const struct ext_session_lock_surface_v1_listener ext_session_lock_surface_v1_listener = {
 	.configure = ext_session_lock_surface_v1_handle_configure,
 };
@@ -402,6 +428,9 @@ static void surface_frame_handle_done(void *data, struct wl_callback *callback,
 	wl_callback_destroy(callback);
 	surface->frame_pending = false;
 
+	// Un configure en attente de tampon libre : réessayer d'abord.
+	apply_pending_configure(surface);
+
 	if (surface->dirty) {
 		// Schedule a frame in case the surface is damaged again
 		struct wl_callback *callback = wl_surface_frame(surface->surface);
