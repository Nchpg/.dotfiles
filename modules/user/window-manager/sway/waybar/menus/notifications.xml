<?xml version="1.0" encoding="UTF-8"?>
<!-- Menu clic droit du module notifications (swaync). Chaque id correspond à
     une clé de `menu-actions` dans modules/user/window-manager/sway/waybar/default.nix. -->
<interface>
  <object class="GtkMenu" id="menu">
    <child>
      <object class="GtkMenuItem" id="dnd">
        <property name="label">Ne pas déranger (on/off)</property>
      </object>
    </child>
    <child>
      <object class="GtkSeparatorMenuItem" id="sep1"/>
    </child>
    <child>
      <object class="GtkMenuItem" id="panel">
        <property name="label">Afficher les notifications</property>
      </object>
    </child>
  </object>
</interface>
