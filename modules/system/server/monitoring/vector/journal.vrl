if !exists(._SYSTEMD_UNIT) {
  ._SYSTEMD_UNIT = "noyau"
}
if !exists(.SYSLOG_IDENTIFIER) {
  .SYSLOG_IDENTIFIER = "-"
}
if !exists(.PRIORITY) {
  .PRIORITY = "6"
}

priorite = to_int(.PRIORITY) ?? 6
.level = "info"
if priorite <= 3 {
  .level = "error"
} else if priorite == 4 {
  .level = "warn"
} else if priorite >= 7 {
  .level = "debug"
}

# dbus-broker journalise en `error` une condition sans conséquence sur NixOS (noms de systemd--user déjà possédés).
msg = to_string(.message) ?? ""
if .SYSLOG_IDENTIFIER == "dbus-broker-launch" && contains(msg, "Ignoring duplicate name") {
  .level = "info"
}
