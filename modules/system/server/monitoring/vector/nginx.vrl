msg = to_string(.message) ?? ""

# La source `file` estampille l'heure de lecture. Journal d'erreurs : heure locale seule, d'où `@TZ@`.
acces = parse_regex(msg, r'\[(?P<t>\d{2}/\w{3}/\d{4}:\d{2}:\d{2}:\d{2} [+-]\d{4})\]') ?? {}
quand = parse_timestamp(to_string(acces.t), "%d/%b/%Y:%H:%M:%S %z") ?? null

if quand == null {
  erreurs = parse_regex(msg, r'^(?P<t>\d{4}/\d{2}/\d{2} \d{2}:\d{2}:\d{2})') ?? {}
  quand = parse_timestamp(to_string(erreurs.t), "%Y/%m/%d %H:%M:%S", "@TZ@") ?? null
}

if quand != null {
  .timestamp = quand
}

._SYSTEMD_UNIT = "nginx"
.SYSLOG_IDENTIFIER = if ends_with(to_string(.file) ?? "", "error.log") {
  "nginx-error"
} else {
  "nginx-access"
}
.host = get_hostname!()

.level = "info"

trouve = parse_regex(msg, r'" (?P<code>\d{3}) ') ?? {}
code = to_int(trouve.code) ?? 0
if code >= 500 {
  .level = "error"
}

# 502 de reconnexion d'un onglet Grafana pendant son redémarrage : reclassés en `info`, pas supprimés.
# `to_string` sans `??` : le compilateur VRL refuse le coalescing sur ce qui ne peut pas échouer.
requete = parse_regex(msg, r'"\w+ (?P<chemin>[^ ?]+)') ?? {}
chemin = to_string(requete.chemin)

# Liste + `includes()` : un `if` dont les `||` s'étalent sur plusieurs lignes ne s'analyse pas en VRL.
sondes_de_fond = [
  "/api/live/ws",
  "/api/login/ping",
  "/api/ds/query",
  "/api/annotations"
]

if code == 502 && includes(sondes_de_fond, chemin) {
  .level = "info"
}

if contains(msg, "[error]") || contains(msg, "[crit]") || contains(msg, "[alert]") {
  .level = "error"
} else if contains(msg, "[warn]") {
  .level = "warn"
}
