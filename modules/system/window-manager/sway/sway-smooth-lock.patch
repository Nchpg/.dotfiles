@@ -279,6 +339,16 @@ static void handle_session_lock(struct wl_listener *listener, void *data) {
 
 	wl_list_init(&sway_lock->outputs);
 
+	sway_lock->reveal_timer = wl_event_loop_add_timer(server.wl_event_loop,
