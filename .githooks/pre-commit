#!/usr/bin/env bash
# Formate les fichiers .nix stagés avec le formatter du flake (nix fmt) puis
# les re-stage. hardware-configuration.nix est exclu (fichier généré).
#
# Installé via : git config core.hooksPath .githooks   (une fois par clone,
# cf. README). Contournement ponctuel : git commit --no-verify.
#
# Limite connue : si un fichier est partiellement stagé (git add -p), le
# re-stage ajoute aussi les modifications non stagées de ce fichier.
set -euo pipefail

# -z / mapfile -d '' : sans ça, git *quote* les chemins non-ASCII
# ("caf\303\251.nix") et le hook tenterait de formater un nom avec guillemets.
mapfile -d '' -t files < <(git diff --cached --name-only -z --diff-filter=ACM -- '*.nix' ':!:*hardware-configuration.nix')
[ ${#files[@]} -eq 0 ] && exit 0

nix fmt -- "${files[@]}"
git add -- "${files[@]}"
